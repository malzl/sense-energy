# Copy to .env and fill in. .env is git-ignored - never commit real credentials.

# Root of the data tree (defaults to code/data when unset)
SENSE_DATA_DIR=code/data

# Weather API (e.g. Met Office / Open-Meteo) - used by src/sense_energy/data/weather.py
WEATHER_API_KEY=
WEATHER_API_BASE_URL=https://api.open-meteo.com/v1

# Experiment tracking (optional)
MLFLOW_TRACKING_URI=file:./mlruns

LOG_LEVEL=INFO

# Copy to .env and fill in. .env is git-ignored - never commit real credentials.

# Root of the data tree (defaults to code/data when unset)
SENSE_DATA_DIR=code/data

# Copernicus Climate Data Store - used by src/sense_energy/data/weather.py
# Register at https://cds.climate.copernicus.eu, then accept the ERA5 licence
# on the dataset page before the API will serve it. Key is the bare UUID.
CDSAPI_URL=https://cds.climate.copernicus.eu/api
CDSAPI_KEY=

# Experiment tracking (optional)
MLFLOW_TRACKING_URI=file:./mlruns

LOG_LEVEL=INFO

# ECMWF account. Only needed for MARS/TIGGE via the Web API, which additionally
# needs ECMWF_API_KEY from https://api.ecmwf.int/v1/key/ - username/password do
# not drive the API. AIFS-ENS open data needs no credentials at all.
ECMWF_USER=
ECMWF_PASSWORD=
ECMWF_API_KEY=

# ENTSO-E Transparency Platform token. Not currently used - see ADR 0003.
ENTSOE_TOKEN=

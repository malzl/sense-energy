# ---- Data (never commit patient- or site-level data) ----
# Ignore the whole data tree, including loose files dropped at its root -
# listing only the subdirectories let a file land in code/data/ and be staged.
code/data/**
!code/data/
!code/data/*/
!code/data/**/.gitkeep
!code/data/README.md
!code/data/**/README.md

# Belt and braces: data file formats are ignored ANYWHERE in the repo, so a
# file dropped outside code/data/ still cannot be committed by accident.
*.parquet
*.csv
*.xlsx
*.xls
*.feather
*.orc
*.avro
*.dta
*.sav
*.zip
*.gz
*.7z
*.tar
# Geospatial formats (shapefile sidecars included).
*.geojson
*.shp
*.shx
*.dbf
*.prj
*.cpg
*.gpkg
# Small fixtures used by the test suite are the deliberate exception.
!code/tests/fixtures/*.csv

# ---- Models & artifacts ----
code/models/*
!code/models/.gitkeep
code/reports/figures/*
!code/reports/figures/.gitkeep
mlruns/
*.joblib
*.pkl
*.h5
*.onnx

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.python-version

# ---- Tooling caches ----
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/

# ---- Notebooks ----
.ipynb_checkpoints/

# ---- Secrets / env ----
.env
.env.*
!.env.example
*.pem
*.key

# ---- OS / editor ----
.DS_Store
Thumbs.db
.idea/
.vscode/
